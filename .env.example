# Copy to `.env` and fill in the values. `.env` is git-ignored: never commit it.
# Key names only. Each phase adds the keys it needs.

# development | test | production
APP_ENV=
LOG_LEVEL=
# true shows tracebacks. Refused in production (S-02).
DEBUG=

# Local: SQLite under .data/. Production: Supabase pooler URL (Phase 18).
DATABASE_URL=

# Days before a deleted account is purged (P5.10). Default 30.
DELETION_GRACE_DAYS=
# Local data folder (exports until storage, Phase 6). Default .data/ at the repo root.
DATA_DIR=

# Hours a run may await approval before it expires (P3.6). Default 24.
APPROVAL_TTL_HOURS=

# Where emailed links point (P5.4): the frontend. Default http://localhost:3000.
APP_URL=

# Origins allowed to send unsafe requests (P5.3, S-25), as a JSON list. Default ["http://localhost:3000"].
ALLOWED_ORIGINS=

# Signs access tokens (P5.2). Secret, 256+ random bits; required in production.
JWT_SECRET=

# AI planner (Phase 12). Secret.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
